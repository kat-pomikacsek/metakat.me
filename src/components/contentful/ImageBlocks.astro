---
import ImageBlock from './ImageBlock.astro';
import { LAYOUT_INLINE } from '../../lib/contentful/images';

interface Props {
  blocks: {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    fields: Record<string, any>;
  }[];
}

const { blocks } = Astro.props;
const hasInlineImages = blocks.some((block) => block.fields.layout === LAYOUT_INLINE);
const wrapperClass = hasInlineImages ? 'sm:grid sm:grid-cols-2 sm:gap-8 sm:max-w-2xl' : '';
---

<div class="flex items-center justify-center">
  <div class:list={['images-wrapper', wrapperClass]}>
    {blocks.map((block) => <ImageBlock entry={block} />)}
  </div>
</div>
