---
import type { ContentfulAsset } from '../../lib/contentful/images';
import { getBaseUrl, isSvg, LAYOUT_FULL_WIDTH } from '../../lib/contentful/images';
import ContentfulPicture from './ContentfulPicture.astro';

interface Props {
  image: ContentfulAsset;
  breakpoint?: string;
  mobileWidth?: number;
  desktopWidth?: number;
  class?: string;
  layout?: string;
  loading?: 'lazy' | 'eager';
}

const {
  image,
  breakpoint,
  mobileWidth,
  desktopWidth,
  class: className,
  layout = LAYOUT_FULL_WIDTH,
  loading = 'lazy',
} = Astro.props;

const isSvgImage = isSvg(image);
---

{isSvgImage ? (
  <img
    class={`image-svg ${layout}`}
    src={getBaseUrl(image)}
    alt={image.fields.title}
    loading={loading}
    decoding="async"
  />
) : (
  <ContentfulPicture
    image={image}
    breakpoint={breakpoint}
    mobileWidth={mobileWidth}
    desktopWidth={desktopWidth}
    class={className}
    loading={loading}
  />
)}
