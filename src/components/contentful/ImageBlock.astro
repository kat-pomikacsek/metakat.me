---
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
import ContentfulImage from './ContentfulImage.astro';
import type { ContentfulAsset } from '../../lib/contentful/images';
import { LAYOUT_INLINE } from '../../lib/contentful/images';

interface Props {
  entry: {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    fields: Record<string, any>;
  };
}

const { entry } = Astro.props;
const theme = entry.fields.theme || '';
const layout = entry.fields.layout || '';
const caption = entry.fields.caption || '';
const figureClass = layout === LAYOUT_INLINE ? 'sm:max-w-xs' : '';
const captionHtml = caption ? documentToHtmlString(caption) : '';
const images = (entry.fields.images || []) as ContentfulAsset[];
---

<div class:list={['block-image', layout, theme]}>
  <figure class={figureClass}>
    <div class="flex flex-wrap justify-center">
      {images.map((image) => (
        <div class="block-image--image">
          <ContentfulImage image={image} layout={layout} />
        </div>
      ))}
    </div>
    {captionHtml && <figcaption set:html={captionHtml} />}
  </figure>
</div>
